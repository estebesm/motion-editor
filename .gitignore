# Секреты
.env

# Видео-проекты пользователей: сценарии, исходники, озвучка, готовые ролики
videos/
# Локальные материалы отдельных проектов (архивы, записи, бренд-ассеты)
_local/

# Зависимости и кэш движка
engine/node_modules/
engine/public/generated/
engine/.cache/

# Библиотека звуков скачивается при первом запуске (Openverse, CC0)
sfx/library/

# Сторонние инструменты ставятся отдельно (см. README → «Звуки»)
tools/

# Системное
.DS_Store
.claude/
*.log
